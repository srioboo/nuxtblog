---
import { transformImg } from '../utils/transformImg';
import { formatDate } from '../utils/formatDate';

interface Props {
  path: string;
  title: string;
  date: Date | string;
  description: string;
  image?: string;
  alt?: string;
}

const { path, title, date, description, image, alt = 'no-alt' } = Astro.props as Props;
---

<div class="blog">
  <a href={path} class="blog__link flex flex-col 2xl:flex-col no-underline shadow-sm hover:shadow-md transition-shadow duration-150">
    <img
      src={transformImg(image)}
      alt={alt}
      class="h-48 w-1/2 object-cover max-w-full min-w-full"
      loading="lazy"
    />
    <div class="blog__content p-6 flex flex-col justify-between w-full">
      <h2 class="blog__title font-bold">
        {title}
      </h2>
      <p class="blog__content__year text-xs">
        {formatDate(date)}
      </p>
      <p class="blog__content__description text-sm font-bold text-gray-600 w-full">
        {description}
      </p>
    </div>
  </a>
</div>
