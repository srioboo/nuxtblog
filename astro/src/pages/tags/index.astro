---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const posts = await getCollection('blog');

const byTag = new Map<string, CollectionEntry<'blog'>[]>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    const existing = byTag.get(tag) ?? [];
    existing.push(post);
    byTag.set(tag, existing);
  }
}

const tags = [...byTag.keys()].sort((a, b) => a.localeCompare(b));
for (const tag of tags) {
  byTag.get(tag)!.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
}
---

<Layout title="Tags | Salrion Blog" description="Entradas agrupadas por etiqueta" path="/tags">
  <Header />
  <div class="main m-9">
    <h1 class="h1 my-8 mx-0 text-gray-900 border-gray-200 font-bold">
      Tags
    </h1>
    {
      tags.map((tag) => (
        <section class="mb-12">
          <h2 class="my-5 border-b border-gray-300 font-bold text-gray-600">{tag}</h2>
          <ul class="container flex flex-wrap list-none">
            {byTag.get(tag)!.map((post) => (
              <li class="article-card py-0 px-2 sm:w-1/2 mb-6 sm:mb-12">
                <BlogCard
                  path={`/blog/${post.id}`}
                  title={post.data.title}
                  date={post.data.date}
                  description={post.data.description}
                  image={post.data.image}
                  alt={post.data.alt}
                />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <Footer />
</Layout>
